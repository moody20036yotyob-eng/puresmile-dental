  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "env": {
    "JWT_SECRET": "puresmile_jwt_secret_2025_production_key",
    "ADMIN_PASSWORD": "admin123",
    "ALLOWED_ORIGIN": "https://clinc5.vercel.app"
  }
}
